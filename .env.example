# Database

# JDBC URL for the PostgreSQL database used by EMOS.
EMOS_DB_URL=jdbc:postgresql://localhost:5432/emos
# PostgreSQL user EMOS uses to connect to the database.
EMOS_DB_USER=emos
# PostgreSQL password for the configured database user; replace this local example outside development.
EMOS_DB_PASSWORD=emos

# Jira Service Management alert ingestion

# Enables calls to Jira Service Management (JSM) for alert ingestion.
EMOS_JSM_ENABLED=false
# Root URL of the JSM Operations API; normally this does not include a cloud ID or endpoint path.
EMOS_JSM_BASE_URL=https://api.atlassian.com/jsm/ops
# Atlassian cloud ID identifying the JSM site to poll.
EMOS_JSM_CLOUD_ID=11111111-2222-3333-4444-555555555555
# Atlassian account email associated with the JSM API token.
EMOS_JSM_EMAIL=manager@example.com
# Atlassian API token used to authenticate JSM requests; use a secret value in your local .env file.
EMOS_JSM_TOKEN=replace-with-jsm-api-token
# Enables scheduled JSM polling; when omitted, it follows EMOS_JSM_ENABLED.
EMOS_JSM_SCHEDULING_ENABLED=false
# Delay between JSM polling runs, expressed as an ISO-8601 duration.
EMOS_JSM_POLL_INTERVAL=PT2M

# Datadog evidence enrichment

# Enables Datadog monitor and metric enrichment for ingested alerts.
EMOS_DATADOG_ENABLED=false
# Root URL of the Datadog API for the account's site or region.
EMOS_DATADOG_BASE_URL=https://api.datadoghq.com
# Datadog API key used to identify the account; use a secret value in your local .env file.
EMOS_DATADOG_API_KEY=replace-with-datadog-api-key
# Datadog application key granting read access; use a scoped secret in your local .env file.
EMOS_DATADOG_APPLICATION_KEY=replace-with-datadog-application-key

# Working calendar

# IANA time-zone ID used to calculate working-hour deadlines.
EMOS_CALENDAR_ZONE=Asia/Kolkata
# Comma-separated ISO dates excluded from working time, without spaces.
EMOS_CALENDAR_HOLIDAYS=2026-01-26,2026-08-15

# AI recommendations

# Enables AI-generated incident analysis and recommended next actions.
EMOS_RECOMMENDATIONS_ENABLED=false
# Root URL of the OpenAI-compatible API used for recommendations.
EMOS_OPENAI_BASE_URL=https://api.openai.com
# API key for the recommendation provider; use a secret value in your local .env file.
OPENAI_API_KEY=replace-with-openai-api-key
# Model identifier used to generate recommendations.
EMOS_OPENAI_MODEL=gpt-5

# GitHub repository discovery

# Enables GitHub repository metadata lookup for fix-repository suggestions.
EMOS_GITHUB_ENABLED=false
# Root URL of the GitHub API; change this for GitHub Enterprise Server.
EMOS_GITHUB_BASE_URL=https://api.github.com
# GitHub organization whose repositories EMOS may inspect.
EMOS_GITHUB_ORGANIZATION=example-engineering
# GitHub token with read-only access to the configured organization; use a secret in your local .env.
GITHUB_TOKEN=replace-with-read-only-github-token

# Jira improvement tickets

# Enables Jira issue lookup and improvement-ticket creation.
EMOS_JIRA_ENABLED=false
# Base URL of the Jira site, without a trailing REST API path.
EMOS_JIRA_BASE_URL=https://example.atlassian.net
# Atlassian account email used to authenticate Jira API requests.
EMOS_JIRA_USER=manager@example.com
# Atlassian API token used to authenticate Jira requests; use a secret value in your local .env file.
EMOS_JIRA_TOKEN=replace-with-jira-api-token
# Jira project key where EMOS creates improvement tickets.
EMOS_JIRA_PROJECT=ENG

# Application links and email notifications

# Browser-visible EMOS URL included in links generated by the backend.
EMOS_BASE_URL=http://localhost:5173
# Enables delivery of manager email notifications and digests.
EMOS_EMAIL_ENABLED=false
# Email address that receives manager notifications and digests.
EMOS_MANAGER_EMAIL=manager@example.com
# SMTP server hostname used by Spring Mail.
SPRING_MAIL_HOST=smtp.example.com
# SMTP server port; 587 is commonly used for STARTTLS submission.
SPRING_MAIL_PORT=587
# Username used to authenticate with the SMTP server.
SPRING_MAIL_USERNAME=mailer@example.com
# Password or app-specific token for the SMTP user; use a secret value in your local .env file.
SPRING_MAIL_PASSWORD=replace-with-smtp-password

# Usage telemetry

# Interval between browser activity heartbeats, expressed as an ISO-8601 duration.
EMOS_TELEMETRY_HEARTBEAT=PT60S
# Inactivity duration after which a browser session is considered idle, expressed as an ISO-8601 duration.
EMOS_TELEMETRY_IDLE_CUTOFF=PT120S
